# Line ending normalization
# 强制所有文本文件用 LF（Linux 兼容），Windows-only 脚本才用 CRLF
# 这样无论开发者在哪个平台编辑，提交到仓库的内容都是一致的

# 文本文件：强制 LF
* text=auto eol=lf

# 明确指定：所有 shell 脚本、配置文件必须是 LF
*.sh         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.prop       text eol=lf
*.txt        text eol=lf

# Git 元数据
.gitignore   text eol=lf
.gitattributes text eol=lf
LICENSE      text eol=lf
README.md    text eol=lf

# 二进制文件：标记为 binary，禁止任何转换
*.apk        binary
*.odex       binary
*.vdex       binary
*.dex        binary
*.so         binary
*.aar        binary
*.jar        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.pdf        binary
*.zip        binary
*.tar        binary
*.gz         binary
*.tgz        binary

# Git LFS：大文件（APK/odex/vdex）通过 LFS 存储
# GitHub 限制 100MB/文件，LFS 单独计费（免费 1GB/月）
*.apk        filter=lfs diff=lfs merge=lfs -text
*.odex       filter=lfs diff=lfs merge=lfs -text
*.vdex       filter=lfs diff=lfs merge=lfs -text
